# ChatDB runtime configuration

# Server
CHATDB_SERVER_ADDRESS=:8000
CHATDB_SERVER_MODE=debug

# AI providers
CHATDB_OPENAI_BASE_URL=https://api.openai.com/v1
CHATDB_OPENAI_KEY=
CHATDB_DEEPSEEK_BASE_URL=https://api.deepseek.com
CHATDB_DEEPSEEK_KEY=

# MCP
CHATDB_MCP_ADDRESS=:9000

# JWT
CHATDB_JWT_SECRET=
CHATDB_JWT_EXPIRE_HOURS=24
CHATDB_JWT_ISSUER=chatdb

# SQL safety
CHATDB_DB_READONLY=false

# Traffic MQTT ingest
CHATDB_TRAFFIC_MQTT_ENABLED=false
CHATDB_TRAFFIC_MQTT_BROKER=tcp://iot-mqtt.qi-cloud.com:1883
CHATDB_TRAFFIC_MQTT_TOPIC=zh-iot-jinshan-kakou
CHATDB_TRAFFIC_MQTT_CLIENT_ID_PREFIX=jinshan_
CHATDB_TRAFFIC_MQTT_USERNAME=jinshan
CHATDB_TRAFFIC_MQTT_PASSWORD=
CHATDB_TRAFFIC_MQTT_QOS=1
CHATDB_TRAFFIC_DEDUPE_WINDOW_DAYS=7
CHATDB_TRAFFIC_RAW_PAYLOAD_RETAIN_DAYS=30
CHATDB_TRAFFIC_NO_DATA_WARN_MINUTES=30

# Prompt directory override. Usually not needed.
# CHATDB_PROMPT_DIR=D:\code\ChatDB-master\prompt
